FLAKEHUNTER_DATABASE_URL=sqlite:///./flakehunter.db
# FLAKEHUNTER_DATABASE_URL=postgresql+psycopg://flakehunter:flakehunter@localhost:5432/flakehunter
FLAKEHUNTER_UPLOAD_TOKEN=change-me

# AI diagnosis and fixing
ANTHROPIC_API_KEY=
FLAKEHUNTER_ANTHROPIC_MODEL=claude-opus-5-5
FLAKEHUNTER_AI_EFFORT=high
FLAKEHUNTER_VERIFY_RUNS=100

# Dev only: lets the AI work on local checkouts (needed for the demo repo and evals)
FLAKEHUNTER_ALLOW_LOCAL_REPOS=true

# subprocess (trusted code only) or docker (build Dockerfile.sandbox first)
FLAKEHUNTER_SANDBOX=subprocess

# GitHub App (optional): webhook ingestion, cloning, and pull requests
FLAKEHUNTER_GITHUB_APP_ID=
FLAKEHUNTER_GITHUB_PRIVATE_KEY_PATH=
FLAKEHUNTER_GITHUB_WEBHOOK_SECRET=
